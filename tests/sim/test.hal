loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cia402 count=1
loadrt cia402_drive count=1
loadrt comp names=standard_home_cmp

addf cia402.0.read-all servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf cia402.0.write-all servo-thread
addf cia402-drive.0 servo-thread
addf standard_home_cmp servo-thread

# The drive consumes only cia402's PDO-side outputs.
net drive-statusword cia402-drive.0.statusword => cia402.0.statusword
net drive-opmode-display cia402-drive.0.opmode-display => cia402.0.opmode-display joint.0.cia-opmode-display
net drive-actual-position cia402-drive.0.actual-position => cia402.0.drv-actual-position
net drive-actual-velocity cia402-drive.0.actual-velocity => cia402.0.drv-actual-velocity
net drive-controlword cia402.0.controlword => cia402-drive.0.controlword
net drive-opmode cia402.0.opmode => cia402-drive.0.opmode
net drive-target-position cia402.0.drv-target-position => cia402-drive.0.target-position
net drive-target-velocity cia402.0.drv-target-velocity => cia402-drive.0.target-velocity

# Homecomp owns feedback and enable pass-through; cia402 owns drive control.
net j0-command joint.0.motor-pos-cmd => cia402.0.pos-cmd joint.0.cia-pos-cmd
net j0-velocity-command joint.0.vel-cmd => cia402.0.velocity-cmd joint.0.cia-velocity-cmd
net j0-enable-command joint.0.amp-enable-out => joint.0.cia-enable-in
net j0-enable joint.0.cia-enable-out => cia402.0.enable
net j0-actual-position cia402.0.pos-fb => joint.0.cia-pos-fb-in
net j0-actual-velocity cia402.0.velocity-fb => joint.0.cia-velocity-fb-in
net j0-feedback joint.0.cia-pos-fb-out => joint.0.motor-pos-fb
net j0-velocity-feedback joint.0.cia-velocity-fb-out
net j0-home joint.0.cia-home => cia402.0.home
net j0-homed cia402.0.stat-homed => joint.0.cia-stat-homed
net j0-homing cia402.0.stat-homing => joint.0.cia-stat-homing
net j0-homing-error cia402.0.stat-homing-error => joint.0.cia-stat-homing-error
net j0-drive-fault cia402.0.stat-fault => joint.0.cia-stat-fault

setp joint.0.request-custom-homing 1
setp joint.0.cia-timeout-ms 1000
setp cia402.0.pos-scale 1000
setp cia402.0.velo-scale 1000
setp cia402-drive.0.start-position 0
setp cia402-drive.0.home-position 100000
setp cia402-drive.0.step-size 2500
setp cia402-drive.0.homing-ticks 40

# Joint 1 exercises the unmodified base homing state machine.
net j1-command joint.1.motor-pos-cmd => joint.1.motor-pos-fb => standard_home_cmp.in0
net standard-switch-position => standard_home_cmp.in1
sets standard-switch-position -5
setp standard_home_cmp.hyst 0.1
net standard-home-switch standard_home_cmp.out => joint.1.home-sw-in

net estop-out iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
