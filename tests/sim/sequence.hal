loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cia402 count=3
loadrt cia402_drive count=3

addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread
addf cia402-drive.0 servo-thread
addf cia402-drive.1 servo-thread
addf cia402-drive.2 servo-thread

net drive0-statusword cia402-drive.0.statusword => cia402.0.statusword
net drive0-opmode-display cia402-drive.0.opmode-display => cia402.0.opmode-display joint.0.cia-opmode-display
net drive0-actual-position cia402-drive.0.actual-position => cia402.0.drv-actual-position
net drive0-actual-velocity cia402-drive.0.actual-velocity => cia402.0.drv-actual-velocity
net drive0-controlword cia402.0.controlword => cia402-drive.0.controlword
net drive0-opmode cia402.0.opmode => cia402-drive.0.opmode
net drive0-target-position cia402.0.drv-target-position => cia402-drive.0.target-position
net drive0-target-velocity cia402.0.drv-target-velocity => cia402-drive.0.target-velocity

net drive1-statusword cia402-drive.1.statusword => cia402.1.statusword
net drive1-opmode-display cia402-drive.1.opmode-display => cia402.1.opmode-display joint.1.cia-opmode-display
net drive1-actual-position cia402-drive.1.actual-position => cia402.1.drv-actual-position
net drive1-actual-velocity cia402-drive.1.actual-velocity => cia402.1.drv-actual-velocity
net drive1-controlword cia402.1.controlword => cia402-drive.1.controlword
net drive1-opmode cia402.1.opmode => cia402-drive.1.opmode
net drive1-target-position cia402.1.drv-target-position => cia402-drive.1.target-position
net drive1-target-velocity cia402.1.drv-target-velocity => cia402-drive.1.target-velocity

net drive2-statusword cia402-drive.2.statusword => cia402.2.statusword
net drive2-opmode-display cia402-drive.2.opmode-display => cia402.2.opmode-display joint.2.cia-opmode-display
net drive2-actual-position cia402-drive.2.actual-position => cia402.2.drv-actual-position
net drive2-actual-velocity cia402-drive.2.actual-velocity => cia402.2.drv-actual-velocity
net drive2-controlword cia402.2.controlword => cia402-drive.2.controlword
net drive2-opmode cia402.2.opmode => cia402-drive.2.opmode
net drive2-target-position cia402.2.drv-target-position => cia402-drive.2.target-position
net drive2-target-velocity cia402.2.drv-target-velocity => cia402-drive.2.target-velocity

net j0-command joint.0.motor-pos-cmd => cia402.0.pos-cmd joint.0.cia-pos-cmd
net j0-velocity-command joint.0.vel-cmd => cia402.0.velocity-cmd joint.0.cia-velocity-cmd
net j0-enable-command joint.0.amp-enable-out => joint.0.cia-enable-in
net j0-enable joint.0.cia-enable-out => cia402.0.enable
net j0-actual-position cia402.0.pos-fb => joint.0.cia-pos-fb-in
net j0-actual-velocity cia402.0.velocity-fb => joint.0.cia-velocity-fb-in
net j0-feedback joint.0.cia-pos-fb-out => joint.0.motor-pos-fb
net j0-home joint.0.cia-home => cia402.0.home
net j0-homed cia402.0.stat-homed => joint.0.cia-stat-homed
net j0-homing cia402.0.stat-homing => joint.0.cia-stat-homing
net j0-homing-error cia402.0.stat-homing-error => joint.0.cia-stat-homing-error
net j0-drive-fault cia402.0.stat-fault => joint.0.cia-stat-fault
net j0-op-enabled cia402.0.stat-op-enabled => joint.0.cia-stat-op-enabled

net j1-command joint.1.motor-pos-cmd => cia402.1.pos-cmd joint.1.cia-pos-cmd
net j1-velocity-command joint.1.vel-cmd => cia402.1.velocity-cmd joint.1.cia-velocity-cmd
net j1-enable-command joint.1.amp-enable-out => joint.1.cia-enable-in
net j1-enable joint.1.cia-enable-out => cia402.1.enable
net j1-actual-position cia402.1.pos-fb => joint.1.cia-pos-fb-in
net j1-actual-velocity cia402.1.velocity-fb => joint.1.cia-velocity-fb-in
net j1-feedback joint.1.cia-pos-fb-out => joint.1.motor-pos-fb
net j1-home joint.1.cia-home => cia402.1.home
net j1-homed cia402.1.stat-homed => joint.1.cia-stat-homed
net j1-homing cia402.1.stat-homing => joint.1.cia-stat-homing
net j1-homing-error cia402.1.stat-homing-error => joint.1.cia-stat-homing-error
net j1-drive-fault cia402.1.stat-fault => joint.1.cia-stat-fault
net j1-op-enabled cia402.1.stat-op-enabled => joint.1.cia-stat-op-enabled

net j2-command joint.2.motor-pos-cmd => cia402.2.pos-cmd joint.2.cia-pos-cmd
net j2-velocity-command joint.2.vel-cmd => cia402.2.velocity-cmd joint.2.cia-velocity-cmd
net j2-enable-command joint.2.amp-enable-out => joint.2.cia-enable-in
net j2-enable joint.2.cia-enable-out => cia402.2.enable
net j2-actual-position cia402.2.pos-fb => joint.2.cia-pos-fb-in
net j2-actual-velocity cia402.2.velocity-fb => joint.2.cia-velocity-fb-in
net j2-feedback joint.2.cia-pos-fb-out => joint.2.motor-pos-fb
net j2-home joint.2.cia-home => cia402.2.home
net j2-homed cia402.2.stat-homed => joint.2.cia-stat-homed
net j2-homing cia402.2.stat-homing => joint.2.cia-stat-homing
net j2-homing-error cia402.2.stat-homing-error => joint.2.cia-stat-homing-error
net j2-drive-fault cia402.2.stat-fault => joint.2.cia-stat-fault
net j2-op-enabled cia402.2.stat-op-enabled => joint.2.cia-stat-op-enabled

setp joint.0.request-custom-homing 1
setp joint.1.request-custom-homing 1
setp joint.2.request-custom-homing 1
setp joint.0.cia-timeout-ms 2000
setp joint.1.cia-timeout-ms 2000
setp joint.2.cia-timeout-ms 2000

setp cia402.0.pos-scale 1000
setp cia402.1.pos-scale 1000
setp cia402.2.pos-scale 1000
setp cia402.0.velo-scale 1000
setp cia402.1.velo-scale 1000
setp cia402.2.velo-scale 1000

setp cia402-drive.0.start-position 0
setp cia402-drive.1.start-position 20000
setp cia402-drive.2.start-position 40000
setp cia402-drive.0.home-position 100000
setp cia402-drive.1.home-position 120000
setp cia402-drive.2.home-position 140000
setp cia402-drive.0.step-size 2500
setp cia402-drive.1.step-size 2500
setp cia402-drive.2.step-size 2500
setp cia402-drive.0.homing-ticks 30
setp cia402-drive.1.homing-ticks 30
setp cia402-drive.2.homing-ticks 30
# The middle sequence joint requires mode 6 before accepting the start edge.
setp cia402-drive.1.scenario 5
# The last sequence joint presents one stale homed pulse on mode entry.
setp cia402-drive.2.scenario 4

net estop-out iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
