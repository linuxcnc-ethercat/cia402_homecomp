component cia402_homecomp "CiA 402 drive-internal homing module";

description """
Custom homing module for CiA 402 drives used with linuxcnc-ethercat's
cia402 component.  The cia402 component remains the sole owner of the
drive controlword and operation mode.  This module coordinates LinuxCNC
homing, feedback, drive enable, timeout, and final position handling.

Build with HOMING_BASE pointing at the matching LinuxCNC source tree's
src/emc/motion/homing.c.  Load through [EMCMOT]HOMEMOD=cia402_homecomp.
""";

pin out bit is_module=1;

license "GPL";
author "Rod Webster; linuxcnc-ethercat contributors";
option homemod;
option extra_setup;
;;

#include "homing_config.h"
#ifndef HOMING_BASE
#error "HOMING_BASE must name the matching LinuxCNC homing.c"
#endif

#define STR(s) #s
#define XSTR(s) STR(s)
#define USE_HOMING_BASE XSTR(HOMING_BASE)
#define CUSTOM_HOMEMODULE
#include USE_HOMING_BASE

#include "cia402_homecomp.h"
#include <string.h>

#define CIA_OPMODE_HOMING 6
#define CIA_DEFAULT_TIMEOUT_MS 30000

static cia402_joint_t *ciaJ;
static double cia_servo_period;
static int cia_comp_id;

EXTRA_SETUP()
{
    (void)__comp_inst;
    (void)prefix;
    (void)extra_arg;
    return 0;
}

// Pin storage uses the legacy pointer declarations on both HAL APIs.
// lcec_hal_compat.h maps access to opaque references on the new API.
static int custom_pin_new(hal_type_t type, hal_pin_dir_t dir,
                          void **data_ptr_addr, double def,
                          const char *name)
{
#ifdef LCEC_HAL_NEW_API
    switch (type) {
    case HAL_BIT:
        return hal_pin_new_bool(cia_comp_id, dir,
            (hal_bool_t *)data_ptr_addr, def != 0, "%s", name);
    case HAL_FLOAT:
        return hal_pin_new_real(cia_comp_id, dir,
            (hal_real_t *)data_ptr_addr, def, "%s", name);
    case HAL_S32:
        return hal_pin_new_si32(cia_comp_id, dir,
            (hal_sint_t *)data_ptr_addr, (int32_t)def, "%s", name);
    case HAL_U32:
        return hal_pin_new_ui32(cia_comp_id, dir,
            (hal_uint_t *)data_ptr_addr, (uint32_t)def, "%s", name);
    default:
        return -EINVAL;
    }
#else
    int r = hal_pin_new(name, type, dir, data_ptr_addr, cia_comp_id);
    if (r) return r;
    switch (type) {
    case HAL_BIT:
        LCEC_PIN_BIT_SET((hal_bit_t *)*data_ptr_addr, def != 0);
        break;
    case HAL_FLOAT:
        LCEC_PIN_FLOAT_SET((hal_float_t *)*data_ptr_addr, def);
        break;
    case HAL_S32:
        LCEC_PIN_S32_SET((hal_s32_t *)*data_ptr_addr, (int32_t)def);
        break;
    case HAL_U32:
        LCEC_PIN_U32_SET((hal_u32_t *)*data_ptr_addr, (uint32_t)def);
        break;
    default:
        return -EINVAL;
    }
    return 0;
#endif
}

#define CHK(expr) do { int _r = (expr); if (_r) return _r; } while (0)

static int custom_makepins(int id, int njoints)
{
    int jno;
    char name[HAL_NAME_LEN + 1];

    cia_comp_id = id;
    if (njoints <= 0) return 0;
    ciaJ = hal_malloc(sizeof(*ciaJ) * njoints);
    if (!ciaJ) return -ENOMEM;
    memset(ciaJ, 0, sizeof(*ciaJ) * njoints);

    for (jno = 0; jno < njoints; jno++) {
        cia402_joint_t *c = &ciaJ[jno];
#define PIN(field, type, dir, def, suffix)                              \
        do {                                                            \
            rtapi_snprintf(name, sizeof(name), "joint.%d.cia-" suffix, jno); \
            CHK(custom_pin_new(type, dir, (void **)&c->field, def, name)); \
        } while (0)
        rtapi_snprintf(name, sizeof(name),
                       "joint.%d.request-custom-homing", jno);
        CHK(custom_pin_new(HAL_BIT, HAL_IN,
            (void **)&c->request_custom_homing, 0, name));
        rtapi_snprintf(name, sizeof(name),
                       "joint.%d.is-custom-homing", jno);
        CHK(custom_pin_new(HAL_BIT, HAL_OUT,
            (void **)&c->is_custom_homing, 0, name));

        PIN(cia_enable_in, HAL_BIT, HAL_IN, 0, "enable-in");
        PIN(cia_enable_out, HAL_BIT, HAL_OUT, 0, "enable-out");
        PIN(cia_pos_cmd, HAL_FLOAT, HAL_IN, 0, "pos-cmd");
        PIN(cia_velocity_cmd, HAL_FLOAT, HAL_IN, 0, "velocity-cmd");
        PIN(cia_pos_fb_in, HAL_FLOAT, HAL_IN, 0, "pos-fb-in");
        PIN(cia_velocity_fb_in, HAL_FLOAT, HAL_IN, 0, "velocity-fb-in");
        PIN(cia_pos_fb_out, HAL_FLOAT, HAL_OUT, 0, "pos-fb-out");
        PIN(cia_velocity_fb_out, HAL_FLOAT, HAL_OUT, 0, "velocity-fb-out");
        PIN(cia_home, HAL_BIT, HAL_IO, 0, "home");
        PIN(cia_stat_homed, HAL_BIT, HAL_IN, 0, "stat-homed");
        PIN(cia_stat_homing, HAL_BIT, HAL_IN, 0, "stat-homing");
        PIN(cia_stat_homing_error, HAL_BIT, HAL_IN, 0, "stat-homing-error");
        PIN(cia_stat_fault, HAL_BIT, HAL_IN, 0, "stat-fault");
        PIN(cia_opmode_display, HAL_S32, HAL_IN, 0, "opmode-display");
        PIN(cia_state, HAL_S32, HAL_OUT, 0, "state");
        PIN(cia_timeout_ms, HAL_U32, HAL_IN, CIA_DEFAULT_TIMEOUT_MS,
            "timeout-ms");
#undef PIN
    }
    return 0;
}

static bool custom_selected(int jno)
{
    return LCEC_PIN_BIT_GET(ciaJ[jno].request_custom_homing) ||
           ciaJ[jno].state != CIA_HOME_IDLE;
}

static bool custom_holding_feedback(int jno)
{
    cia_home_state_t state = ciaJ[jno].state;
    return state == CIA_HOME_WAIT_MODE || state == CIA_HOME_RUNNING;
}

static void custom_update_outputs(int jno)
{
    cia402_joint_t *c = &ciaJ[jno];
    bool homing = custom_holding_feedback(jno);

    LCEC_PIN_BIT_SET(c->is_custom_homing,
        LCEC_PIN_BIT_GET(c->request_custom_homing));
    LCEC_PIN_BIT_SET(c->cia_home, homing);
    LCEC_PIN_S32_SET(c->cia_state, c->state);
    LCEC_PIN_BIT_SET(c->cia_enable_out,
        LCEC_PIN_BIT_GET(c->cia_enable_in) && !c->enable_inhibit);

    if (homing) {
        LCEC_PIN_FLOAT_SET(c->cia_pos_fb_out,
            LCEC_PIN_FLOAT_GET(c->cia_pos_cmd));
        LCEC_PIN_FLOAT_SET(c->cia_velocity_fb_out,
            LCEC_PIN_FLOAT_GET(c->cia_velocity_cmd));
    } else {
        LCEC_PIN_FLOAT_SET(c->cia_pos_fb_out,
            LCEC_PIN_FLOAT_GET(c->cia_pos_fb_in));
        LCEC_PIN_FLOAT_SET(c->cia_velocity_fb_out,
            LCEC_PIN_FLOAT_GET(c->cia_velocity_fb_in));
    }
}

// Synchronize LinuxCNC to the actual scaled motor position.  At successful
// homing, choose the offset that makes the reference equal HOME_OFFSET.
// On abort, preserve the existing coordinate offset.
static void custom_sync_position(int jno, bool at_home)
{
    cia402_joint_t *c = &ciaJ[jno];
    emcmot_joint_t *joint = &joints[jno];
    double actual = LCEC_PIN_FLOAT_GET(c->cia_pos_fb_in);

    if (at_home) {
        joint->motor_offset = actual - H[jno].home_offset;
    }
    joint->motor_pos_fb = actual;
    joint->pos_fb = actual - (joint->backlash_filt + joint->motor_offset);
    joint->pos_cmd = joint->pos_fb;
    joint->motor_pos_cmd = actual;
    joint->free_tp.curr_pos = joint->pos_fb;
    joint->free_tp.pos_cmd = joint->pos_fb;
    joint->free_tp.enable = 0;
}

static void custom_abort(int jno, const char *reason)
{
    cia402_joint_t *c = &ciaJ[jno];
    if (c->state == CIA_HOME_IDLE) return;

    rtapi_print_msg(RTAPI_MSG_ERR,
        "cia402_homecomp: joint %d homing aborted: %s\n", jno, reason);
    c->enable_inhibit = 1;
    c->state = CIA_HOME_BASE;
    custom_sync_position(jno, false);
    H[jno].home_state = HOME_ABORT;
}

static void custom_finish_drive_homing(int jno)
{
    cia402_joint_t *c = &ciaJ[jno];
    custom_sync_position(jno, true);
    c->state = CIA_HOME_BASE;
    if (H[jno].home_flags & HOME_NO_FINAL_MOVE) {
        H[jno].home_state = HOME_FINISHED;
    } else {
        H[jno].home_state = HOME_FINAL_MOVE_START;
    }
}

static int custom_1joint_state_machine(int jno)
{
    cia402_joint_t *c = &ciaJ[jno];

    if (c->state == CIA_HOME_BASE) {
        int busy = base_1joint_state_machine(jno);
        if (H[jno].home_state == HOME_IDLE) c->state = CIA_HOME_IDLE;
        return busy;
    }

    if (H[jno].home_state == HOME_IDLE) {
        c->state = CIA_HOME_IDLE;
        return 0;
    }

    if (H[jno].home_state == HOME_START && c->state == CIA_HOME_IDLE) {
        H[jno].homing = 1;
        H[jno].homed = 0;
        joints[jno].free_tp.enable = 0;
        c->enable_inhibit = 0;
        c->elapsed_ns = 0;
        c->state = CIA_HOME_WAIT_MODE;
        return 1;  // Let cia402 see the home request first.
    }

    if (c->state != CIA_HOME_WAIT_MODE && c->state != CIA_HOME_RUNNING) {
        c->elapsed_ns = 0;
        c->state = CIA_HOME_WAIT_MODE;
    }

    c->elapsed_ns += (int64_t)(cia_servo_period * 1000000000.0 + 0.5);

    if (LCEC_PIN_BIT_GET(c->cia_stat_fault)) {
        custom_abort(jno, "drive fault");
    } else if (LCEC_PIN_BIT_GET(c->cia_stat_homing_error)) {
        custom_abort(jno, "drive reported homing error");
    } else if (LCEC_PIN_BIT_GET(c->cia_stat_homed)) {
        custom_finish_drive_homing(jno);
    } else {
        uint32_t timeout_ms = LCEC_PIN_U32_GET(c->cia_timeout_ms);
        if (timeout_ms &&
            c->elapsed_ns >= (int64_t)timeout_ms * 1000000LL) {
            custom_abort(jno, "timeout");
        } else if (LCEC_PIN_S32_GET(c->cia_opmode_display) == CIA_OPMODE_HOMING) {
            c->state = CIA_HOME_RUNNING;
        }
    }
    return 1;
}

int homing_init(int id, double servo_period, int n_joints,
                int n_extrajoints, emcmot_joint_t *pjoints)
{
    cia_servo_period = servo_period;
    CHK(base_homing_init(id, servo_period, n_joints,
                         n_extrajoints, pjoints));
    CHK(custom_makepins(id, n_joints));
    return 0;
}

void read_homing_in_pins(int njoints)
{
    int jno;
    base_read_homing_in_pins(njoints);
    if (!ciaJ) return;
    for (jno = 0; jno < njoints; jno++) custom_update_outputs(jno);
}

void write_homing_out_pins(int njoints)
{
    int jno;
    base_write_homing_out_pins(njoints);
    if (!ciaJ) return;
    for (jno = 0; jno < njoints; jno++) {
        // Track any residual drive motion after an abort while keeping the
        // drive disabled and the joint unhomed.
        if (ciaJ[jno].enable_inhibit && H[jno].home_state == HOME_IDLE) {
            custom_sync_position(jno, false);
        }
        custom_update_outputs(jno);
    }
}

bool do_homing(void)
{
    int jno;
    int busy = 0;
    bool beginning_allhomed = base_get_allhomed();

    do_homing_sequence();
    for (jno = 0; jno < all_joints; jno++) {
        if (ciaJ && ciaJ[jno].state != CIA_HOME_IDLE &&
            H[jno].home_state == HOME_IDLE) {
            if (!H[jno].homed && !ciaJ[jno].enable_inhibit) {
                custom_sync_position(jno, false);
            }
            ciaJ[jno].state = CIA_HOME_IDLE;
        }
        if (!H[jno].joint_in_sequence) continue;
        if (!GET_JOINT_ACTIVE_FLAG(&joints[jno])) continue;
        if (ciaJ && custom_selected(jno)) {
            busy += custom_1joint_state_machine(jno);
        } else {
            busy += base_1joint_state_machine(jno);
        }
    }
    if (busy > 0) {
        homing_active = 1;
    } else if (sequence_state == HOME_SEQUENCE_IDLE) {
        homing_active = 0;
    }
    if (!beginning_allhomed && base_get_allhomed()) {
        homing_active = 0;
        return 1;
    }
    return 0;
}

bool get_allhomed(void)                       { return base_get_allhomed(); }
bool get_homed(int jno)                       { return base_get_homed(jno); }
bool get_home_is_idle(int jno)                { return base_get_home_is_idle(jno); }
bool get_home_is_synchronized(int jno)        { return base_get_home_is_synchronized(jno); }
bool get_home_needs_unlock_first(int jno)     { return base_get_home_needs_unlock_first(jno); }
int  get_home_sequence(int jno)               { return base_get_home_sequence(jno); }
bool get_homing(int jno)                      { return base_get_homing(jno); }
bool get_homing_at_index_search_wait(int jno) { return base_get_homing_at_index_search_wait(jno); }
bool get_homing_is_active(void)               { return base_get_homing_is_active(); }
bool get_index_enable(int jno)                { return base_get_index_enable(jno); }

void do_home_joint(int jno) { base_do_home_joint(jno); }

void do_cancel_homing(int jno)
{
    if (ciaJ && jno >= 0 && jno < all_joints && custom_selected(jno)) {
        custom_abort(jno, "cancelled");
    }
    base_do_cancel_homing(jno);
}

void set_unhomed(int jno, motion_state_t motstate)
{
    base_set_unhomed(jno, motstate);
}

