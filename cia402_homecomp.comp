                             double home_final_vel, double home_search_vel,
                             double home_latch_vel, int home_flags,
                             int home_sequence, bool volatile_home)
{
    base_set_joint_homing_params(jno, offset, home, home_final_vel,
        home_search_vel, home_latch_vel, home_flags, home_sequence,
        volatile_home);
}
